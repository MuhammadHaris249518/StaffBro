<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Staffbro Business Dashboard</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "on-primary": "#ffffff",
            "on-tertiary": "#ffffff",
            "surface-container-high": "#dce9ff",
            "surface-variant": "#d3e4fe",
            "primary-fixed-dim": "#7cd8af",
            "error-container": "#ffdad6",
            "on-primary-container": "#a7ffd5",
            "primary-fixed": "#98f5ca",
            "on-error-container": "#93000a",
            "surface-container": "#e5eeff",
            "on-secondary": "#ffffff",
            "on-tertiary-container": "#b2ffba",
            "on-secondary-container": "#586377",
            "surface": "#f8f9ff",
            "secondary-container": "#d5e0f8",
            "inverse-primary": "#7cd8af",
            "on-background": "#0b1c30",
            "surface-container-lowest": "#ffffff",
            "tertiary-fixed": "#66ff8e",
            "primary-container": "#0d7a57",
            "surface-tint": "#006c4c",
            "on-surface-variant": "#3e4943",
            "on-tertiary-fixed": "#002109",
            "background": "#f8f9ff",
            "primary": "#005f42",
            "tertiary-container": "#007c36",
            "tertiary": "#006029",
            "on-primary-fixed-variant": "#005138",
            "secondary-fixed-dim": "#bcc7de",
            "inverse-surface": "#213145",
            "on-tertiary-fixed-variant": "#005322",
            "on-secondary-fixed-variant": "#3c475a",
            "tertiary-fixed-dim": "#3de273",
            "on-primary-fixed": "#002114",
            "outline-variant": "#bec9c1",
            "outline": "#6e7a72",
            "secondary-fixed": "#d8e3fb",
            "on-surface": "#0b1c30",
            "on-secondary-fixed": "#111c2d",
            "surface-container-highest": "#d3e4fe",
            "surface-dim": "#cbdbf5",
            "surface-bright": "#f8f9ff",
            "secondary": "#545f73",
            "inverse-on-surface": "#eaf1ff",
            "surface-container-low": "#eff4ff",
            "on-error": "#ffffff",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "space-xl": "2rem",
            "gutter-mobile": "0.75rem",
            "space-xs": "0.25rem",
            "margin-mobile": "1rem",
            "gutter": "1rem",
            "margin": "1.5rem",
            "space-lg": "1.5rem",
            "space-sm": "0.5rem",
            "space-md": "1rem"
          },
          "fontFamily": {
            "body-sm": ["Noto Sans"],
            "body-md": ["Noto Sans"],
            "headline-xl-mobile": ["Plus Jakarta Sans"],
            "headline-lg-mobile": ["Plus Jakarta Sans"],
            "label-md": ["Noto Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "label-sm": ["Noto Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "headline-xl": ["Plus Jakarta Sans"],
            "label-lg": ["Noto Sans"],
            "body-lg": ["Noto Sans"]
          },
          "fontSize": {
            "body-sm": ["13px", {"lineHeight": "18px", "fontWeight": "400"}],
            "body-md": ["14px", {"lineHeight": "22px", "fontWeight": "400"}],
            "headline-xl-mobile": ["26px", {"lineHeight": "34px", "fontWeight": "700"}],
            "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "700"}],
            "label-md": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
            "headline-lg": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
            "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "600"}],
            "headline-md": ["18px", {"lineHeight": "26px", "fontWeight": "600"}],
            "headline-xl": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
            "label-lg": ["14px", {"lineHeight": "20px", "fontWeight": "600"}],
            "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "500"}]
          }
        },
      },
    }
  </script>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-surface antialiased min-h-screen flex flex-col justify-between selection:bg-primary-fixed selection:text-on-primary-fixed">
<!-- Application Shell / TopAppBar based on Shared Components JSON -->
<header class="sticky top-0 z-40 bg-surface-container-lowest dark:bg-inverse-surface shadow-sm">
<div class="flex justify-between items-center w-full px-margin-mobile h-14">
<!-- Brand & Urdu subhead -->
<div class="flex items-center gap-2">
<div class="w-9 h-9 rounded-lg bg-primary-container text-on-primary flex items-center justify-center shadow-sm">
<span class="material-symbols-outlined text-[22px]" data-icon="storefront">storefront</span>
</div>
<div>
<div class="flex items-center gap-1.5">
<span class="text-headline-md font-headline-md text-primary dark:text-inverse-primary font-bold tracking-tight">Staffbro</span>
<span class="bg-surface-container text-primary text-[10px] font-bold px-1.5 py-0.5 rounded">BUSINESS</span>
</div>
<p class="font-label-sm text-label-sm text-secondary leading-none">کاروباری پورٹل</p>
</div>
</div>
<!-- Action Cluster -->
<div class="flex items-center gap-1">
<button aria-label="Notifications" class="relative min-w-[48px] min-h-[48px] flex items-center justify-center rounded-xl hover:bg-surface-container-high transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-on-surface-variant text-[24px]" data-icon="notifications">notifications</span>
<span class="absolute top-2.5 right-2.5 w-2.5 h-2.5 rounded-full bg-error ring-2 ring-surface-container-lowest"></span>
</button>
<button aria-label="Business Profile Menu" class="min-w-[48px] min-h-[48px] flex items-center justify-center rounded-xl hover:bg-surface-container-high transition-colors active:scale-95 duration-150">
<div class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md flex items-center justify-center font-bold">
            KS
          </div>
</button>
</div>
</div>
</header>
<!-- Main Scrollable Canvas (Mobile 360-412px target) -->
<main class="flex-1 w-full max-w-md mx-auto px-margin-mobile pt-3 pb-24 space-y-4">
<!-- Active Business Identity Card -->
<section class="bg-surface-container-lowest rounded-xl p-3.5 border border-outline-variant/30 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)]">
<div class="flex items-start justify-between gap-2">
<div class="flex items-center gap-3">
<div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary relative">
<span class="material-symbols-outlined text-[26px]" data-icon="restaurant">restaurant</span>
<div class="absolute -bottom-1 -right-1 bg-primary text-on-primary rounded-full p-0.5" title="Verified Employer">
<span class="material-symbols-outlined text-[12px] block" data-icon="verified" style="font-variation-settings: 'FILL' 1;">verified</span>
</div>
</div>
<div>
<div class="flex items-center gap-1.5 flex-wrap">
<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface leading-tight">Khyber Shinwari Restaurant</h1>
</div>
<p class="font-body-sm text-body-sm text-secondary flex items-center gap-1 mt-0.5">
<span class="material-symbols-outlined text-[14px]" data-icon="location_on">location_on</span>
<span>F-10 Markaz, Islamabad</span>
</p>
</div>
</div>
<button aria-label="Switch Branch" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary hover:bg-surface-container rounded-lg active:scale-95">
<span class="material-symbols-outlined text-[20px]" data-icon="sync_alt">sync_alt</span>
</button>
</div>
<div class="mt-3 pt-2.5 border-t border-outline-variant/20 flex items-center justify-between">
<div class="inline-flex items-center gap-1.5 bg-primary-fixed/40 px-2.5 py-1 rounded-full text-primary font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[14px]" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<span>Verified &amp; Active (تصدیق شدہ)</span>
</div>
<span class="font-label-sm text-label-sm text-secondary">ID: #ISB-8924</span>
</div>
</section>
<!-- Metrics Bento Row -->
<section class="grid grid-cols-3 gap-2">
<!-- Metric 1: Open Jobs -->
<div class="bg-surface-container-lowest p-3 rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-[0_1px_3px_0_rgba(15,23,42,0.05)]">
<div class="flex items-center justify-between">
<span class="material-symbols-outlined text-primary text-[20px]" data-icon="work">work</span>
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
</div>
<div class="mt-2">
<span class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface font-extrabold block leading-none">3</span>
<p class="font-label-sm text-label-sm text-on-surface-variant font-medium mt-1">Active Jobs</p>
<p class="font-label-sm text-[10px] text-secondary">فعال نوکریاں</p>
</div>
</div>
<!-- Metric 2: New Applicants -->
<div class="bg-surface-container-lowest p-3 rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-[0_1px_3px_0_rgba(15,23,42,0.05)]">
<div class="flex items-center justify-between">
<span class="material-symbols-outlined text-primary-container text-[20px]" data-icon="group">group</span>
<span class="bg-primary-fixed text-on-primary-fixed text-[10px] font-bold px-1.5 py-0.2 rounded-full">+4 New</span>
</div>
<div class="mt-2">
<span class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface font-extrabold block leading-none">12</span>
<p class="font-label-sm text-label-sm text-on-surface-variant font-medium mt-1">Applicants</p>
<p class="font-label-sm text-[10px] text-secondary">نئے امیدوار</p>
</div>
</div>
<!-- Metric 3: Direct Offers -->
<div class="bg-surface-container-lowest p-3 rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-[0_1px_3px_0_rgba(15,23,42,0.05)]">
<div class="flex items-center justify-between">
<span class="material-symbols-outlined text-secondary text-[20px]" data-icon="send">send</span>
<span class="material-symbols-outlined text-secondary text-[16px]" data-icon="schedule">schedule</span>
</div>
<div class="mt-2">
<span class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface font-extrabold block leading-none">5</span>
<p class="font-label-sm text-label-sm text-on-surface-variant font-medium mt-1">Pending Offers</p>
<p class="font-label-sm text-[10px] text-secondary">پیشکش زیرِ انتظار</p>
</div>
</div>
</section>
<!-- Primary Action Hero CTA Button (Post New Job) -->
<section>
<button class="w-full min-h-[52px] bg-primary-container text-on-primary rounded-xl px-4 py-3 flex items-center justify-between shadow-md active:scale-[0.98] transition-transform duration-150 hover:bg-primary">
<div class="flex items-center gap-2.5">
<div class="w-8 h-8 rounded-lg bg-on-primary/15 flex items-center justify-center">
<span class="material-symbols-outlined text-[22px]" data-icon="add_circle">add_circle</span>
</div>
<div class="text-left">
<span class="font-label-lg text-label-lg font-bold block leading-none text-white">+ Post New Job</span>
<span class="font-label-sm text-label-sm text-on-primary-container leading-tight">نیا ملازم یا کاریگر کا اشتہار لگائیں</span>
</div>
</div>
<span class="material-symbols-outlined text-white text-[20px]" data-icon="chevron_right">chevron_right</span>
</button>
</section>
<!-- Twin Cities Urgent Worker Discovery Banner -->
<section class="bg-secondary-container/40 border border-outline-variant/40 rounded-xl p-3.5 flex items-center justify-between gap-3">
<div class="flex items-start gap-2.5">
<div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex-shrink-0 flex items-center justify-center">
<span class="material-symbols-outlined text-[24px]" data-icon="badge">badge</span>
</div>
<div>
<h3 class="font-label-lg text-label-lg font-bold text-on-surface leading-tight">Need urgent staff right now?</h3>
<p class="font-body-sm text-body-sm text-secondary mt-0.5">500+ verified workers ready in Islamabad &amp; Pindi</p>
</div>
</div>
<button class="min-h-[48px] px-3 py-1.5 bg-surface-container-lowest border border-outline-variant text-primary font-label-md text-label-md rounded-lg whitespace-nowrap active:scale-95 flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[16px]" data-icon="search">search</span>
<span>ورکر تلاش کریں</span>
</button>
</section>
<!-- Jobs Section Header with Filter Tabs -->
<section class="space-y-2.5">
<div class="flex items-center justify-between pt-1">
<div>
<h2 class="font-headline-md text-headline-md text-on-surface font-bold leading-tight">Open Job Postings</h2>
<p class="font-label-sm text-label-sm text-secondary">موجودہ جاب لسٹنگز اور درخواستیں</p>
</div>
<button class="text-primary font-label-md text-label-md min-h-[48px] px-2 flex items-center gap-0.5 hover:underline">
<span>Filter</span>
<span class="material-symbols-outlined text-[18px]" data-icon="tune">tune</span>
</button>
</div>
<!-- Job Cards Flow -->
<div class="space-y-3">
<!-- Job Card 1 (High Applicant Activity) -->
<article class="bg-surface-container-lowest rounded-xl p-3.5 border border-outline-variant/30 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-start justify-between gap-2">
<div>
<div class="flex items-center gap-2">
<span class="bg-tertiary-fixed/30 text-tertiary font-label-sm text-label-sm font-bold px-2 py-0.5 rounded-md">Urgent Hiring</span>
<span class="text-secondary font-label-sm text-label-sm">Full-time • دن کی شفٹ</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold mt-1">Head Chef / Karahi Specialist</h3>
<p class="font-body-sm text-body-sm font-semibold text-primary mt-0.5">PKR 45,000 - 55,000 / month</p>
</div>
<button aria-label="Job Options" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary hover:bg-surface-container rounded-lg active:scale-95">
<span class="material-symbols-outlined text-[20px]" data-icon="more_vert">more_vert</span>
</button>
</div>
<!-- Applicant Activity Alert Bar -->
<div class="bg-surface-container/60 rounded-lg px-3 py-2 flex items-center justify-between">
<div class="flex items-center gap-2">
<div class="flex -space-x-1.5">
<div class="w-6 h-6 rounded-full bg-primary-container text-on-primary font-label-sm text-[10px] flex items-center justify-center ring-2 ring-surface-container-lowest">A</div>
<div class="w-6 h-6 rounded-full bg-secondary text-on-secondary font-label-sm text-[10px] flex items-center justify-center ring-2 ring-surface-container-lowest">R</div>
<div class="w-6 h-6 rounded-full bg-tertiary text-on-tertiary font-label-sm text-[10px] flex items-center justify-center ring-2 ring-surface-container-lowest">+6</div>
</div>
<span class="font-label-md text-label-md font-bold text-on-surface">8 Applicants <span class="text-primary font-normal">(6 نئے)</span></span>
</div>
<span class="font-label-sm text-label-sm text-secondary">Posted 2d ago</span>
</div>
<!-- Bottom Action Buttons: 48dp minimum targets -->
<div class="grid grid-cols-2 gap-2 pt-1">
<button class="min-h-[48px] bg-primary-container text-on-primary font-label-md text-label-md rounded-lg flex items-center justify-center gap-1.5 shadow-sm active:scale-95 transition-transform">
<span class="material-symbols-outlined text-[18px]" data-icon="visibility">visibility</span>
<span>View Applicants (امیدوار)</span>
</button>
<button class="min-h-[48px] bg-surface-container-lowest border border-outline text-on-surface font-label-md text-label-md rounded-lg flex items-center justify-center gap-1 hover:bg-surface-container active:scale-95 transition-transform">
<span class="material-symbols-outlined text-[18px]" data-icon="edit">edit</span>
<span>Edit Job (ترمیم)</span>
</button>
</div>
</article>
<!-- Job Card 2: Tandoor Maker -->
<article class="bg-surface-container-lowest rounded-xl p-3.5 border border-outline-variant/30 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-start justify-between gap-2">
<div>
<div class="flex items-center gap-2">
<span class="bg-surface-container text-primary font-label-sm text-label-sm font-bold px-2 py-0.5 rounded-md">Active (فعال)</span>
<span class="text-secondary font-label-sm text-label-sm">Full-time • رہائش شامل ہے</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold mt-1">Tandoor &amp; Naan Maker</h3>
<p class="font-body-sm text-body-sm font-semibold text-primary mt-0.5">PKR 35,000 - 42,000 / month</p>
</div>
<button aria-label="Job Options" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary hover:bg-surface-container rounded-lg active:scale-95">
<span class="material-symbols-outlined text-[20px]" data-icon="more_vert">more_vert</span>
</button>
</div>
<div class="flex items-center justify-between text-body-sm font-body-sm pt-1 border-t border-outline-variant/20">
<div class="flex items-center gap-1.5 text-on-surface font-medium">
<span class="material-symbols-outlined text-primary text-[18px]" data-icon="person_search">person_search</span>
<span>3 Applicants (3 امیدوار)</span>
</div>
<span class="font-label-sm text-label-sm text-secondary">Expires in 12 days</span>
</div>
<div class="flex items-center gap-2">
<button class="flex-1 min-h-[48px] bg-surface-container text-primary font-label-md text-label-md rounded-lg flex items-center justify-center gap-1.5 active:scale-95">
<span class="material-symbols-outlined text-[18px]" data-icon="group">group</span>
<span>Review 3 Candidates</span>
</button>
<button class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary border border-outline-variant rounded-lg hover:bg-surface-container active:scale-95" title="Pause Posting">
<span class="material-symbols-outlined text-[20px]" data-icon="pause_circle">pause_circle</span>
</button>
</div>
</article>
<!-- Job Card 3: Front Hall Waiter -->
<article class="bg-surface-container-lowest rounded-xl p-3.5 border border-outline-variant/30 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-start justify-between gap-2">
<div>
<div class="flex items-center gap-2">
<span class="bg-surface-container text-primary font-label-sm text-label-sm font-bold px-2 py-0.5 rounded-md">Active (فعال)</span>
<span class="text-secondary font-label-sm text-label-sm">Full-time • دوپہر تا رات</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold mt-1">Front Hall Waiter (ہال ویٹر)</h3>
<p class="font-body-sm text-body-sm font-semibold text-primary mt-0.5">PKR 30,000 - 35,000 + Daily Tips</p>
</div>
<button aria-label="Job Options" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary hover:bg-surface-container rounded-lg active:scale-95">
<span class="material-symbols-outlined text-[20px]" data-icon="more_vert">more_vert</span>
</button>
</div>
<div class="flex items-center justify-between text-body-sm font-body-sm pt-1 border-t border-outline-variant/20">
<div class="flex items-center gap-1.5 text-on-surface font-medium">
<span class="material-symbols-outlined text-secondary text-[18px]" data-icon="person_search">person_search</span>
<span>1 Applicant (1 امیدوار)</span>
</div>
<span class="font-label-sm text-label-sm text-secondary">Posted 4d ago</span>
</div>
<div class="flex items-center gap-2">
<button class="flex-1 min-h-[48px] bg-surface-container text-primary font-label-md text-label-md rounded-lg flex items-center justify-center gap-1.5 active:scale-95">
<span class="material-symbols-outlined text-[18px]" data-icon="group">group</span>
<span>Review Candidate</span>
</button>
<button class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary border border-outline-variant rounded-lg hover:bg-surface-container active:scale-95" title="Pause Posting">
<span class="material-symbols-outlined text-[20px]" data-icon="pause_circle">pause_circle</span>
</button>
</div>
</article>
<!-- Draft / Inactive Job Card: Kitchen Cleaner -->
<article class="bg-surface-container-low/60 rounded-xl p-3.5 border border-dashed border-outline-variant space-y-2 opacity-90">
<div class="flex items-start justify-between gap-2">
<div>
<div class="flex items-center gap-2">
<span class="bg-secondary-container text-on-secondary-container font-label-sm text-label-sm px-2 py-0.5 rounded-md">Paused / Filled (بند شدہ)</span>
<span class="text-secondary font-label-sm text-label-sm">Closed 1 week ago</span>
</div>
<h3 class="font-headline-md text-headline-md text-secondary font-semibold mt-1">Kitchen Cleaner &amp; Dishwasher</h3>
<p class="font-body-sm text-body-sm text-secondary">PKR 28,000 - 32,000</p>
</div>
<button aria-label="Job Options" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-secondary hover:bg-surface-container rounded-lg active:scale-95">
<span class="material-symbols-outlined text-[20px]" data-icon="more_vert">more_vert</span>
</button>
</div>
<div class="flex items-center justify-between pt-1">
<span class="font-label-sm text-label-sm text-secondary">Candidate hired via Staffbro</span>
<button class="min-h-[48px] px-3 text-primary font-label-md text-label-md flex items-center gap-1 active:scale-95">
<span class="material-symbols-outlined text-[18px]" data-icon="replay">replay</span>
<span>Re-post (دوبارہ لگائیں)</span>
</button>
</div>
</article>
</div>
</section>
<!-- WhatsApp Support Floating Trigger / Callout for MSME Owners -->
