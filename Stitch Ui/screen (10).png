</div>
<!-- Staffbro Direct Reach Philosophy (Direct Contact Prompt) -->
<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
