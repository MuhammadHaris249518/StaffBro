<div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm px-0.5">
<span class="flex items-center gap-1 text-primary font-semibold">
<span class="material-symbols-outlined text-[16px]">restaurant</span>
          Food &amp; Kitchen Roles
        </span>
<span class="text-secondary flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">schedule</span>
