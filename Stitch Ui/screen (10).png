</div>
</div>
</div>
</section>
<!-- Job Description & Duties -->
<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">assignment</span>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold">Responsibilities &amp; Work Details</h3>
</div>
<ul class="space-y-2.5 font-body-md text-body-md text-on-surface">
