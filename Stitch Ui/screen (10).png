<!-- Business & Role Hero Card -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<!-- Verified Header -->
<div class="flex items-start justify-between gap-2">
<div class="space-y-1">
<div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#ECFDF5] border border-primary/20 text-primary font-label-sm text-label-sm">
