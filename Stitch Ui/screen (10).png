<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">check_circle</span>
<span>Cooking authentic Shinwari Mutton &amp; Chicken Karahi, Dumba Karahi, Koyla BBQ, and traditional Handi.</span>
</li>
<li class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">check_circle</span>
<span>Kitchen hygiene management, meat quality check, and everyday spice &amp; oil inventory supervision.</span>
</li>
<li class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">check_circle</span>
<span>Managing 3 assistant kitchen helpers (Karahi helper, tandoor helper, dishwasher).</span>
</li>
<li class="flex items-start gap-2.5">
<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">schedule</span>
<span><strong class="text-on-surface font-semibold">Duty Hours:</strong> 3:00 PM to 12:30 AM (Dinner peak rush).</span>
</li>
</ul>
<!-- Requirements Chips -->
<div class="pt-2 border-t border-surface-container flex flex-wrap gap-1.5">
<span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md">Valid CNIC Required</span>
<span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md">Non-Smoker Preferred</span>
<span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md">Shinwari Expertise</span>
</div>
</section>
<!-- Workplace Location Card -->
<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">pin_drop</span>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold">Workplace Location</h3>
</div>
<span class="font-label-sm text-label-sm text-primary font-semibold">Islamabad</span>
</div>
<div class="p-3 bg-surface-container-low rounded-lg border border-outline-variant/30 space-y-2">
<div class="flex items-start gap-2">
<span class="material-symbols-outlined text-error text-[20px] shrink-0 mt-0.5">location_on</span>
<div>
<p class="font-label-lg text-label-lg text-on-surface font-bold">F-10 Markaz, Islamabad</p>
<p class="font-body-sm text-body-sm text-on-surface-variant">Near roundabout, Main Commercial Boulevard</p>
</div>
</div>
<div class="flex items-center gap-1.5 text-secondary font-label-sm text-label-sm pt-1 border-t border-outline-variant/20">
<span class="material-symbols-outlined text-[16px]">directions_bus</span>
<span>Easy commute from Rawalpindi (via Kashmir Highway &amp; Metro feeder).</span>
</div>
</div>
</section>
</main>
<!-- Bottom Floating Action Dock (Full width, elevated Level 3, thumb-accessible) -->
<footer class="fixed bottom-0 left-0 right-0 max-w-md mx-auto z-50 bg-surface-container-lowest shadow-[0_-2px_8px_0_rgba(15,23,42,0.06)] border-t border-outline-variant/20 p-margin-mobile space-y-2">
<!-- Anti-fraud & Zero-Fee Guarantee Badge -->
<div class="flex items-center justify-center gap-1 text-center">
<span class="material-symbols-outlined text-primary text-[15px] fill-icon">verified_user</span>
<span class="font-label-sm text-label-sm text-secondary font-medium">
          Staffbro never charges workers. Apply 100% free.
        </span>
</div>
<!-- Quick Note Drawer (Hidden initially, opens on trigger) -->
<div class="hidden transition-all duration-200 ease-out bg-surface-container-low rounded-lg p-2.5 border border-primary/30 space-y-2" id="quickNoteSection">
<div class="flex items-center justify-between">
<label class="font-label-sm text-label-sm text-on-surface font-bold flex items-center gap-1" for="applicantNote">
<span class="material-symbols-outlined text-[16px] text-primary">edit_note</span>
            Optional note to employer (مختصر نوٹ)
          </label>
<span class="text-[11px] font-mono text-secondary" id="charCount">0/200</span>
</div>
<textarea class="w-full text-body-sm font-body-md rounded-md border-outline-variant/60 focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest p-2 text-on-surface placeholder:text-outline" id="applicantNote" maxlength="200" oninput="updateCharCount(this)" placeholder="e.g. 3 years experience in Namak Mandi, ready to join immediately." rows="2"></textarea>
</div>
<!-- Action Button Area -->
<div class="flex gap-2">
<!-- Note Toggle Button (48dp target) -->
<button aria-label="Add optional note" class="min-w-[48px] min-h-[52px] px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface-variant flex items-center justify-center active:scale-95 hover:bg-surface-container transition-all" id="toggleNoteBtn" onclick="toggleNoteDrawer()" type="button">
<span class="material-symbols-outlined text-[22px]">note_add</span>
</button>
<!-- Primary Apply Button (Min 52dp tap target, high contrast emerald) -->
<button class="flex-1 min-h-[52px] px-4 py-3 rounded-lg bg-primary-container text-on-primary font-headline-md text-headline-md font-bold flex items-center justify-center gap-2 active:scale-95 hover:brightness-105 transition-all shadow-md" id="applySubmitBtn" onclick="submitApplication()" type="button">
<span class="material-symbols-outlined text-[22px] fill-icon">how_to_reg</span>
<span id="applyBtnText">Apply to Job (درخواست جمع کروائیں)</span>
</button>
</div>
</footer>
<!-- Success Feedback Overlay Modal -->
<div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm transition-opacity" id="successModal">
<div class="bg-surface-container-lowest rounded-xl max-w-xs w-full p-5 text-center space-y-4 shadow-2xl border border-outline-variant/30">
<div class="w-14 h-14 mx-auto rounded-full bg-[#ECFDF5] text-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[36px] fill-icon">check_circle</span>
</div>
<div>
<h4 class="font-headline-md text-headline-md text-on-surface font-bold">Application Sent!</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
            Khyber Shinwari has received your profile. You can also call or WhatsApp them directly.
          </p>
</div>
<div class="space-y-2 pt-2">
<a class="w-full min-h-[48px] px-4 py-2.5 rounded-lg bg-[#25D366] text-[#064E3B] font-label-lg text-label-lg font-bold flex items-center justify-center gap-2" href="https://wa.me/923008550192">
<span class="material-symbols-outlined text-[20px] fill-icon">chat</span>
<span>Chat on WhatsApp</span>
</a>
<button class="w-full min-h-[44px] text-secondary font-label-md text-label-md hover:text-on-surface" onclick="closeSuccessModal()" type="button">
            Done &amp; View More Jobs
          </button>
</div>
</div>
</div>
</div>
<!-- Inline Interaction Logic -->
<script>
    let isBookmarked = false;
    let noteDrawerOpen = false;

    function toggleBookmark() {
      isBookmarked = !isBookmarked;
      const icon = document.getElementById('bookmarkIcon');
      if (isBookmarked) {
        icon.classList.add('fill-icon', 'text-primary');
        icon.classList.remove('text-on-surface-variant');
      } else {
        icon.classList.remove('fill-icon', 'text-primary');
        icon.classList.add('text-on-surface-variant');
      }
    }

    function toggleNoteDrawer() {
      noteDrawerOpen = !noteDrawerOpen;
      const drawer = document.getElementById('quickNoteSection');
      const toggleBtn = document.getElementById('toggleNoteBtn');
      if (noteDrawerOpen) {
        drawer.classList.remove('hidden');
        toggleBtn.classList.add('bg-secondary-container', 'border-primary', 'text-primary');
        document.getElementById('applicantNote').focus();
      } else {
        drawer.classList.add('hidden');
        toggleBtn.classList.remove('bg-secondary-container', 'border-primary', 'text-primary');
      }
    }

    function updateCharCount(el) {
      document.getElementById('charCount').innerText = `${el.value.length}/200`;
    }

    function submitApplication() {
      const applyBtn = document.getElementById('applySubmitBtn');
      const applyText = document.getElementById('applyBtnText');
      applyBtn.disabled = true;
      applyText.innerText = 'Submitting...';

      setTimeout(() => {
        applyBtn.disabled = false;
        applyText.innerText = 'Applied ✓ (درخواست موصول)';
        applyBtn.classList.remove('bg-primary-container');
        applyBtn.classList.add('bg-tertiary');
        document.getElementById('successModal').classList.remove('hidden');
      }, 700);
    }

    function closeSuccessModal() {
      document.getElementById('successModal').classList.add('hidden');
    }
  </script>
</body></html>