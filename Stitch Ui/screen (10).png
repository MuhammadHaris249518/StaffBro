<body class="bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex justify-center selection:bg-primary-fixed selection:text-on-primary-fixed">
<!-- Mobile Screen Container (360x800 canonical base) -->
<div class="w-full max-w-md bg-surface flex flex-col min-h-screen relative shadow-2xl">
<!-- Top App Bar (Task flow: Destination rule suppresses global BottomNav; retains TopAppBar with back action) -->
<header class="sticky top-0 z-40 bg-surface-container-lowest shadow-sm flex items-center justify-between px-margin-mobile h-14">
<div class="flex items-center gap-2">
<button aria-label="Go back to jobs" class="min-w-[48px] min-h-[48px] -ml-2 flex items-center justify-center rounded-xl text-primary hover:bg-surface-container-high active:scale-95 transition-all" type="button">
<span class="material-symbols-outlined text-[24px]">arrow_back</span>
</button>
<span class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Staffbro</span>
</div>
<div class="flex items-center gap-1">
<button aria-label="Share Job" class="min-w-[48px] min-h-[48px] flex items-center justify-center rounded-xl text-on-surface-variant hover:bg-surface-container-high active:scale-95 transition-all" type="button">
<span class="material-symbols-outlined text-[22px]">share</span>
</button>
<button aria-label="Save Job" class="min-w-[48px] min-h-[48px] flex items-center justify-center rounded-xl text-on-surface-variant hover:bg-surface-container-high active:scale-95 transition-all" id="bookmarkBtn" onclick="toggleBookmark()" type="button">
<span class="material-symbols-outlined text-[22px]" id="bookmarkIcon">bookmark</span>
</button>
</div>
</header>
<!-- Main Scrollable Content Canvas -->
<main class="flex-1 px-margin-mobile pt-3 pb-36 space-y-4">
