<span class="material-symbols-outlined text-[20px]">call</span>
<span>Call (0300-855xxxx)</span>
</a>
</div>
</section>
<!-- Perks & Benefits Section (Asymmetric Modern Card) -->
<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-4 shadow-[0_1px_3px_0_rgba(15,23,42,0.05)] space-y-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-tertiary-container text-[20px]">redeem</span>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold">Perks &amp; Benefits Provided</h3>
</div>
<div class="space-y-2">
