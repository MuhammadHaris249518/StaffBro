<!-- WhatsApp Business Button (#25D366) -->
<a class="min-h-[48px] px-3.5 py-2.5 rounded-lg bg-[#25D366] text-[#064E3B] font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-sm active:scale-95 hover:brightness-95 transition-all" href="https://wa.me/923008550192?text=Assalam-o-Alaikum,%20I%20am%20interested%20in%20the%20Head%20Chef%20position%20on%20Staffbro." rel="noopener noreferrer" target="_blank">
