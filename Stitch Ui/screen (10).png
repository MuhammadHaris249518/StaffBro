            "on-tertiary-fixed": "#002109",
            "on-surface": "#0b1c30",
            "primary-container": "#0d7a57",
            "inverse-on-surface": "#eaf1ff",
            "surface": "#f8f9ff",
            "on-primary-fixed": "#002114",
            "surface-bright": "#f8f9ff"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "gutter-mobile": "0.75rem",
            "space-md": "1rem",
            "space-xl": "2rem",
            "margin-mobile": "1rem",
            "gutter": "1rem",
            "space-xs": "0.25rem",
