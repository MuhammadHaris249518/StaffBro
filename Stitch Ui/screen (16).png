              "Noto Sans"
            ],
            "body-md": [
              "Noto Sans"
            ],
            "body-sm": [
              "Noto Sans"
            ],
            "headline-lg": [
              "Plus Jakarta Sans"
            ],
            "headline-lg-mobile": [
              "Plus Jakarta Sans"
            ],
