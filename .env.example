# Copy to .env and fill locally. Never commit real secrets.

# API
APP_ENV=local
APP_VERSION=0.2.0
DATABASE_URL=postgresql+asyncpg://staffbro:staffbro@localhost:5432/staffbro
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.onrender\.com
INTERNAL_TASKS_SECRET=change-me-before-phase-10
JWT_SECRET=dev-only-change-before-any-public-deploy
SEED_ON_START=true
# PORT=8000

# Mobile / admin (public API origin only — no secrets in the app bundle)
EXPO_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

